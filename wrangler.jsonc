{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcc-tower",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "r2_buckets": [
    {
      "binding": "PROJECT_DOCS",
      "bucket_name": "brainee-docs",
    }
  ],
  "observability": {
    "enabled": true,
  },
}
